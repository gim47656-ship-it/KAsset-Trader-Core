+def _ev(last: dt.datetime, *, has_latest: bool, partial_end=None):
+    return job.SymbolCollectionEvidence(
+        last_collected_at=last,
+        has_latest_period=has_latest,
+        earliest_partial_period_end=partial_end,
+    )
