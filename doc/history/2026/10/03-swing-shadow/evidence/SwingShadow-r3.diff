+def test_same_pullback_cycle_keeps_one_anchor_on_consecutive_days() -> None:
+    days = _weekdays(101)
+    bars = _trend(days[:100], {97})
+    last = bars[-1].close
+    bars.append(_bar(days[100], last + 10, last + 300, last, last + 250, 150000))
+
+    day_one = _candidate(
+        _evaluate(bars, days, signal_session=days[99]),
