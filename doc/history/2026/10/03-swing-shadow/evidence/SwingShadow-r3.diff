+
+def test_outcome_uses_next_session_open_and_costs() -> None:
+    sessions = _forward(10)
+    bars = {
+        day: _bar(day, 100 + i, 104 + i, 97 + i, 101 + i)
+        for i, day in enumerate(sessions)
