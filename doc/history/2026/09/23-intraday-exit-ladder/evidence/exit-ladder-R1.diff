+@pytest.mark.unit
+def test_us_fractional_exit_keeps_its_existing_quantum() -> None:
+    assert _quantity_for_signal(
+        market="US",
+        held_quantity=D("0.0004"),
+        fraction=D("0.3"),
+    ) == D("0.0001")
+    assert _quantity_for_signal(
+        market="US",
+        held_quantity=D("0.0003"),
+        fraction=D("0.3"),
+    ) == D("0.0000")
+
