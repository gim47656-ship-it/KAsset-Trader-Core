+@pytest.mark.asyncio
+async def test_succeeded_partial_raises_floor_at_reconciliation_tick_not_past_bucket() -> (
+    None
+):
+    key = "position-exit:partial:23"
+    state_row = _state_row(
+        last_exit_signal_key=key,
+        last_evaluated_at=_candle(1).time_utc,
+    )
+    previous = _exit_recommendation(
+        key,
+        kind="PARTIAL_SELL",
+        execution_status="SUCCEEDED",
+        valid_until=ENTRY_AT + timedelta(days=5),
+    )
+    db = MagicMock()
+    db.scalar = AsyncMock(side_effect=[state_row, previous, state_row, previous])
+    db.get = AsyncMock(return_value=None)
+    db.flush = AsyncMock()
+    db.add = MagicMock()
+    now = ENTRY_AT + timedelta(days=3, hours=1)
+    service = _manager(db, now=now)
+    position = _paper_position(quantity="2")
+
+    assert (
+        await service._manage_position(
+            owner_user_id=23,
+            account_id=17,
+            market="KRX",
+            position=position,
+            rows=[],
+        )
+        is None
+    )
+    assert state_row.partial_exit_completed is True
+    assert state_row.current_stop == D("100")
+    assert state_row.exit_levels_effective_at == now
+    assert state_row.exit_level_history == [
+        {
+            "effectiveAt": None,
+            "initialAtr": "10",
+            "initialStop": "70",
+            "currentStop": "70",
+        }
+    ]
+    assert state_row.last_evaluated_at == _candle(1).time_utc
+
+    assert (
+        await service._manage_position(
+            owner_user_id=23,
+            account_id=17,
+            market="KRX",
+            position=position,
+            rows=[],
+        )
+        is None
+    )
+    assert len(state_row.exit_level_history) == 1
+    prior = _intraday([(0, "99", "100", "90", "99")], day=3)
+    # activation 이전에 시작한 bucket의 저가에는 새 바닥을 소급하지 않는다.
+    assert (
+        evaluate_position_intraday(
+            _state_from_row(state_row),
+            _intraday_position_bars(prior),
+            bar_interval=prior.bar_interval,
+        )
+        is None
+    )
+    following = _intraday([(60, "101", "102", "99", "100")], day=3)
+    stopped = evaluate_position_intraday(
+        _state_from_row(state_row),
+        _intraday_position_bars(following),
+        bar_interval=following.bar_interval,
+    )
+    assert stopped is not None
+    assert stopped.kind is ExitKind.TRAILING_STOP
+    assert stopped.reference_price == D("100")
+
