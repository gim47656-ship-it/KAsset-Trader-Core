+@pytest.mark.asyncio
+async def test_one_kr_share_arms_floor_once_then_exits_only_on_later_bucket() -> None:
+    state_row = _state_row(last_evaluated_at=_candle(1).time_utc)
+    db = MagicMock()
+    db.scalar = AsyncMock(return_value=state_row)
+    db.get = AsyncMock(return_value=None)
+    db.flush = AsyncMock()
+    db.add = MagicMock()
+    now = ENTRY_AT + timedelta(days=3, hours=1)
+    position = _paper_position(quantity="1")
+    bucket = _intraday([(0, "101", "106", "99", "105")], day=3)
+    service = _manager(db, now=now)
+
+    assert (
+        await service._manage_position(
+            owner_user_id=23,
+            account_id=17,
+            market="KRX",
+            position=position,
+            rows=[],
+            intraday=bucket,
+        )
+        is None
+    )
+    activated = bucket.bars[0].timestamp + bucket.bar_interval
+    assert state_row.current_stop == D("100")
+    assert state_row.exit_levels_effective_at == activated
+    assert state_row.exit_level_history == [
+        {
+            "effectiveAt": None,
+            "initialAtr": "10",
+            "initialStop": "70",
+            "currentStop": "70",
+        }
+    ]
+    assert state_row.partial_exit_completed is False
+    assert state_row.last_evaluated_at == _candle(1).time_utc
+    assert not any(
+        isinstance(call_.args[0], AIRecommendation) for call_ in db.add.call_args_list
+    )
+
+    assert (
+        await service._manage_position(
+            owner_user_id=23,
+            account_id=17,
+            market="KRX",
+            position=position,
+            rows=[],
+            intraday=bucket,
+        )
+        is None
+    )
+    assert len(state_row.exit_level_history) == 1
+
+    later = _intraday(
+        [(0, "101", "106", "99", "105"), (5, "104", "105", "99", "101")],
+        day=3,
+    )
+    recommendation_id = await service._manage_position(
+        owner_user_id=23,
+        account_id=17,
+        market="KRX",
+        position=position,
+        rows=[],
+        intraday=later,
+    )
+    assert recommendation_id is not None
+    recommendation = next(
+        call_.args[0]
+        for call_ in db.add.call_args_list
+        if isinstance(call_.args[0], AIRecommendation)
+    )
+    assert recommendation.suggested_quantity == "1"
+    assert recommendation.reference_price == "100"
+    assert state_row.partial_exit_completed is False
+    assert len(state_row.exit_level_history) == 1
+
