# KAsset Trader 서버 환경변수 예시.
# 실제 값은 서버의 .env.kasset 에만 두고 절대 커밋하지 않는다.
# 새 VPS 이전 시 이 파일을 .env.kasset 으로 복사해 값을 채운다.

# --- 코어 ---
ENVIRONMENT=production
SECRET_KEY=            # JWT 서명 키 (openssl rand -hex 32)
PAIRING_SECRET=        # 기기 페어링 코드 시드
CREDENTIAL_MASTER_KEY= # 브로커 자격 Vault AES-256-GCM 마스터 키
DOCS_ENABLED=false

# --- 데이터 ---
DB_PASSWORD=           # compose db 서비스와 DATABASE_URL 양쪽에 동일 적용
DATABASE_URL=postgresql+asyncpg://kasset:${DB_PASSWORD}@db:5432/kasset
REDIS_URL=redis://redis:6379/0

# --- 거래 안전 스위치 ---
TRADING_ENABLED=false        # 전역 Kill Switch 기본값
LIVE_TRADING_ENABLED=false   # 실거래 금지(PAPER 전용 운영)

# --- 인증 ---
KASSET_GOOGLE_OAUTH_CLIENT_ID=   # Android Google id_token aud 검증용
WEB_GOOGLE_OAUTH_CLIENT_ID=      # 웹 Google 로그인 공개 client ID (Android용과 같은 값 금지)
# Caddy 관리자 경계. 공백으로 구분한 IP/CIDR 목록이며, 미설정 시에도
# tailnet IPv4 100.64.0.0/10과 IPv6 fd7a:115c:a1e0::/48만 허용한다.
# 사무실 공인 IP는 확인한 뒤 /32로 추가한다. X-Forwarded-For 값은 사용하지 않는다.
KASSET_ADMIN_ALLOWED_IPS="100.64.0.0/10 fd7a:115c:a1e0::/48"
# Caddy가 API에 덮어쓰는 관리자 ingress 공유 키. `openssl rand -hex 32`로
# 무작위 생성해 서버 .env.kasset에만 저장하고 화면/로그/Compose 출력에 노출하지 않는다.
# production에서는 API가 이 키 없는 /admin* 및 /web-auth* 요청을 403으로 거부하고,
# Compose도 값이 없으면 Caddy를 기동하지 않는다.
KASSET_ADMIN_EDGE_KEY=
# 선택 MagicDNS HTTPS host. 비워 두면 tailnet site block 자체를 만들지 않는다.
KASSET_TAILNET_DOMAIN=
WEB_REGISTRATION_ENABLED=false
# 비밀번호 복구/로그인 cooldown 알림용 SMTP.
# AUTH_SMTP_ALLOW_LEGACY_TLS는 TLS 1.2+가 불가능한 공급자에만 제한적으로 켠다.
AUTH_SMTP_HOST=smtp.fmcity.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM_EMAIL=
AUTH_SMTP_SECURITY=starttls
AUTH_SMTP_ALLOW_LEGACY_TLS=false
AUTH_SMTP_TIMEOUT_SECONDS=10
AUTH_PASSWORD_RESET_BASE_URL=
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# --- 브로커 ---
NHPLUG_MOCK_ENABLED=true
KIS_APP_KEY=
KIS_APP_SECRET=
TOSS_API_ENABLED=true
TOSS_API_CLIENT_ID=
TOSS_API_CLIENT_SECRET=
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
OPENDART_API_KEY=

# --- AI ---
# 복잡한 후보/거래 검토만 MCP -> direct API -> OpenRouter 순서로 사용한다.
# 아래 KASSET_AI_MCP_*는 API가 provider MCP를 가리키는 client 쪽 설정이다.
# `run_skill` 계약을 제공하는 provider가 있을 때만 채운다. 이 Compose의
# analysis_readonly MCP(http://mcp:8768/mcp)는 거래 도구 서버이며 provider가 아니다.
# 이 저장소의 AI provider sidecar(ai-mcp 서비스)를 쓰려면
# KASSET_AI_MCP_URL=http://ai-mcp:8770/mcp 로 두고
# KASSET_AI_MCP_TOKEN 값을 아래 KASSET_AI_SIDECAR_TOKEN 과 똑같이 맞춘다.
KASSET_AI_MCP_URL=
KASSET_AI_MCP_TOKEN=
KASSET_AI_MCP_TOOL_NAME=run_skill
KASSET_AI_MCP_TIMEOUT_SECONDS=30
# AI provider sidecar(ai-mcp 서비스) 자신의 설정. 위 KASSET_AI_MCP_*(client 쪽)과
# 아래 MCP_ANALYSIS_AUTH_TOKEN(거래 도구 서버)과는 완전히 별개 namespace다.
# sidecar는 `run_skill` 도구 하나만 노출하고 broker/account/order 도구가 없으며
# DB/broker 자격을 받지 않는다. 포트를 발행하지 않아 backend 네트워크 전용이고
# Caddy로 공개되지 않는다. profiles 옵트인이라 기본 `up -d`로는 뜨지 않는다.
# CMD/TOKEN 이 비면 sidecar는 기동을 실패한다(잘못된 설정으로 서비스하지 않음).
# CMD 예: codex exec --skip-git-repo-check --sandbox read-only -
KASSET_AI_SIDECAR_CMD=
KASSET_AI_SIDECAR_TOKEN=
# 호출자 KASSET_AI_MCP_TIMEOUT_SECONDS(30)보다 크게 유지한다. 느린 CLI가
# 호출자 timeout=availability 오류로 먼저 드러나야 direct/OpenRouter fallback이 돈다.
KASSET_AI_SIDECAR_TIMEOUT_SECONDS=90
# 동시 처리 상한. 포화 시 HTTP 429로 즉시 거절한다(= availability 신호).
KASSET_AI_SIDECAR_MAX_CONCURRENCY=2
# 뉴스·공시 요약은 MCP를 건너뛰고 direct API부터 사용한다.
KASSET_AI_API_BASE_URL=https://api.openai.com/v1
KASSET_AI_API_KEY=
KASSET_AI_MODEL_LUNA=gpt-5.6-luna
KASSET_AI_MODEL_TERRA=gpt-5.6-terra
KASSET_AI_MODEL_SOL=gpt-5.6-sol
# 네트워크/timeout/HTTP 408·429·5xx availability 오류에만 적용되는 fallback.
# 나머지 4xx/refusal/schema/safety 오류는 fallback 없이 fail-closed한다.
KASSET_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KASSET_AI_OPENROUTER_API_KEY=
KASSET_AI_OPENROUTER_MODEL_FLASH=z-ai/glm-5.3-flash
KASSET_AI_OPENROUTER_MODEL_PRO=z-ai/glm-5.3-flash
# 기존 run_skill 호환 route이며 위 HTTP MCP route와는 별개다.
KASSET_AI_PROVIDER_MODE=hybrid
KASSET_AI_SUBSCRIPTION_CMD=
KASSET_AI_SUBSCRIPTION_TIMEOUT_SECONDS=240
KASSET_MARKET_EVENTS_ENABLED=true

# --- MCP ---
# 거래 도구 서버(mcp 서비스, profile analysis_readonly) 전용 토큰이다.
# AI provider sidecar(ai-mcp)는 KASSET_AI_SIDECAR_TOKEN 을 따로 쓴다.
MCP_ANALYSIS_AUTH_TOKEN=         # 서버 내부 MCP 접근 토큰

# --- Cloudflare Tunnel ---
# Cloudflare One > Networks > Tunnels > kasset-trader 커넥터 토큰.
# 서버 IP가 바뀌어도 api.hsps-portal.xyz 는 이 토큰이 따라간다.
TUNNEL_TOKEN=
# 이 direct tunnel은 public/mobile 전용이며 관리자 edge key를 절대 주입하지 않는다.

# --- 배포 ---
CORE_IMAGE_TAG=   # git rev-parse --short HEAD 값; 배포 스크립트가 갱신
