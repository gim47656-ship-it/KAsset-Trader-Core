# KAsset Trader 서버 환경변수 예시.
# 실제 값은 서버의 .env.kasset 에만 두고 절대 커밋하지 않는다.
# 새 VPS 이전 시 이 파일을 .env.kasset 으로 복사해 값을 채운다.

# --- 코어 ---
ENVIRONMENT=production
SECRET_KEY=            # JWT 서명 키 (openssl rand -hex 32)
PAIRING_SECRET=        # 기기 페어링 코드 시드
CREDENTIAL_MASTER_KEY= # 브로커 자격 Vault AES-256-GCM 마스터 키
DOCS_ENABLED=false

# --- 데이터 ---
DB_PASSWORD=           # compose db 서비스와 DATABASE_URL 양쪽에 동일 적용
DATABASE_URL=postgresql+asyncpg://kasset:${DB_PASSWORD}@db:5432/kasset
REDIS_URL=redis://redis:6379/0

# --- 거래 안전 스위치 ---
TRADING_ENABLED=false        # 전역 Kill Switch 기본값
LIVE_TRADING_ENABLED=false   # 실거래 금지(PAPER 전용 운영)

# --- 인증 ---
KASSET_GOOGLE_OAUTH_CLIENT_ID=   # 웹 클라이언트 ID (aud 검증용)

# --- 브로커 ---
NHPLUG_MOCK_ENABLED=true
KIS_APP_KEY=
KIS_APP_SECRET=
TOSS_API_ENABLED=true
TOSS_API_CLIENT_ID=
TOSS_API_CLIENT_SECRET=
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
OPENDART_API_KEY=

# --- AI ---
KASSET_AI_API_KEY=               # OpenAI API 폴백
KASSET_AI_API_MODEL=gpt-5.6-terra
KASSET_AI_OPENROUTER_API_KEY=
KASSET_AI_SUBSCRIPTION_CMD=      # 구독형 CLI 브리지(비우면 API 폴백)
KASSET_AI_SUBSCRIPTION_TIMEOUT_SECONDS=240
KASSET_MARKET_EVENTS_ENABLED=true

# --- MCP ---
MCP_ANALYSIS_AUTH_TOKEN=         # 서버 내부 MCP 접근 토큰

# --- Cloudflare Tunnel ---
# Cloudflare One > Networks > Tunnels > kasset-trader 커넥터 토큰.
# 서버 IP가 바뀌어도 api.hsps-portal.xyz 는 이 토큰이 따라간다.
TUNNEL_TOKEN=

# --- 배포 ---
CORE_IMAGE_TAG=   # git rev-parse --short HEAD 값; 배포 스크립트가 갱신
