{
  "schema_version": "execution-outcome-mapping-fixture/v2",
  "outcome_fields": [
    "request_validated",
    "mutation_sent",
    "broker_acceptance",
    "tracking",
    "local_recorded",
    "reconcile_required",
    "terminal_evidence"
  ],
  "mappings": {
    "generic.dry_run_success": {
      "surface": "generic",
      "legacy_success_meaning": "request_handled",
      "legacy_response_markers": ["success=true", "dry_run=true"],
      "outcome": [true, false, "not_sent", "not_applicable", false, false, "none"]
    },
    "generic.send_outcome_unknown": {
      "surface": "generic",
      "legacy_success_meaning": "failure_with_unknown_acceptance",
      "legacy_response_markers": [
        "success=false",
        "outcome_unknown=true",
        "reconcile_tool=market_specific"
      ],
      "outcome": [true, true, "unknown", "unknown", false, true, "none"]
    },
    "generic.live_accepted_pending_fill": {
      "surface": "generic",
      "legacy_success_meaning": "broker_accepted_and_local_recorded",
      "legacy_response_markers": [
        "success=true",
        "broker_status=accepted",
        "fill_recorded=false",
        "order_id=non_empty"
      ],
      "outcome": [true, true, "accepted", "tracked", true, true, "none"]
    },
    "generic.live_accepted_untracked_pending_fill": {
      "surface": "generic",
      "legacy_success_meaning": "broker_accepted_and_local_recorded",
      "legacy_response_markers": [
        "success=true",
        "broker_status=accepted",
        "fill_recorded=false",
        "order_id=absent"
      ],
      "outcome": [true, true, "accepted", "untracked", true, true, "none"]
    },
    "toss.accepted_recorded": {
      "surface": "toss",
      "legacy_success_meaning": "broker_accepted_and_local_recorded",
      "legacy_response_markers": [
        "success=true",
        "mutation_sent=true",
        "order_id=present",
        "message=accepted_and_recorded_accepted_only"
      ],
      "outcome": [true, true, "accepted", "tracked", true, true, "none"]
    },
    "toss.http_rejected": {
      "surface": "toss",
      "legacy_success_meaning": "failure_with_definite_rejection",
      "legacy_response_markers": [
        "success=false",
        "mutation_sent=true",
        "status_code=4xx",
        "code=broker_error_code"
      ],
      "outcome": [true, true, "rejected", "not_applicable", false, false, "none"]
    },
    "toss.transport_unknown": {
      "surface": "toss",
      "legacy_success_meaning": "failure_with_unknown_acceptance",
      "legacy_response_markers": [
        "success=false",
        "mutation_sent=true",
        "status_code=absent",
        "error=transport_exception"
      ],
      "outcome": [true, true, "unknown", "unknown", false, true, "none"]
    }
  }
}
