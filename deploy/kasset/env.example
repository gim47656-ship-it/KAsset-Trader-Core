# KAsset provider-neutral production environment template.
# This file contains no secret values. Keep the real Compose env file mode 0600.
# Keep the mounted runtime env and password files outside the repository.
# Relative secret paths are resolved from deploy/kasset; absolute paths are safer.
#
# Empty Linux host sequence (Docker Engine + Compose plugin already installed):
#   1. Point the chosen DNS name at the host. Allow inbound 80/tcp, 443/tcp,
#      and optionally 443/udp for HTTP/3. Do not expose PostgreSQL or Redis.
#   2. cp deploy/kasset/env.example deploy/kasset/.env
#   3. Create an operator-owned 0700 secrets directory outside the checkout.
#      Create three 0600 files there: runtime.env, postgres_password, redis_password.
#      postgres_password and redis_password contain one password each, with no key name.
#      runtime.env uses KEY=value syntax and supplies DATABASE_URL, REDIS_URL,
#      SECRET_KEY, CREDENTIAL_MASTER_KEY, and any enabled broker credentials.
#   4. Set the three *_FILE variables below to absolute paths. Set every image
#      to a registry digest (preferred) or an immutable release tag; never latest.
#   5. docker compose --env-file deploy/kasset/.env -f deploy/kasset/compose.yaml config
#   6. docker compose --env-file deploy/kasset/.env -f deploy/kasset/compose.yaml pull
#   7. docker compose --env-file deploy/kasset/.env -f deploy/kasset/compose.yaml up -d --wait
#   8. scripts/kasset_smoke.sh --env-file deploy/kasset/.env
#   9. scripts/kasset_backup.sh --env-file deploy/kasset/.env --output ./backups
#
# Restore to an empty database:
#   scripts/kasset_restore.sh --env-file deploy/kasset/.env --backup ./backups/<UTC stamp>
# A non-empty database is refused. Only an operator who has taken a separate current
# backup may add --force-overwrite; that flag drops and recreates the target database.

# Compose identity and immutable images (all required; no latest fallback).
KASSET_PROJECT_NAME=kasset
KASSET_IMAGE=
CADDY_IMAGE=
POSTGRES_IMAGE=
REDIS_IMAGE=

# Public TLS ingress.
KASSET_DOMAIN=
ACME_EMAIL=

# Optional web terminal. Leave the inert path/upstream defaults unless a separately
# managed terminal service is attached to the Compose edge network.
KASSET_WEB_TERMINAL_PATH=/__kasset_terminal_not_configured__
KASSET_WEB_TERMINAL_UPSTREAM=127.0.0.1:65535

# Secret file references. Values belong in the referenced files, not here.
KASSET_RUNTIME_ENV_FILE=
POSTGRES_PASSWORD_FILE=
REDIS_PASSWORD_FILE=

# PostgreSQL and Redis non-secret topology. Passwords must agree with runtime.env URLs.
POSTGRES_USER=kasset
POSTGRES_DB=kasset
POSTGRES_SHM_SIZE=256m
REDIS_DB=0

# Runtime connection values: populate only in the mounted runtime.env.
# Percent-encode reserved characters in URL credentials.
DATABASE_URL=
REDIS_URL=

# Required application secret material: populate only in runtime.env.
# SECRET_KEY must satisfy the Core validator (32+ chars with upper/lower/digits).
SECRET_KEY=
CREDENTIAL_MASTER_KEY=
# Public web client ID used for Google ID Token aud and Android serverClientId.
KASSET_GOOGLE_OAUTH_CLIENT_ID=87055660911-049dp7t9frnr0dali9k60t71ulm8tjdm.apps.googleusercontent.com

# Core currently requires these settings at startup. Empty keeps their capabilities
# unconfigured; put real credentials only in runtime.env when explicitly enabled.
KIS_APP_KEY=
KIS_APP_SECRET=
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
OPENDART_API_KEY=

# Safe gates. PAPER use requires an explicit operator enable plus owner-level opt-in.
TRADING_ENABLED=false
LIVE_TRADING_ENABLED=false
AI_PAPER_AUTO_EXECUTION_ENABLED=false
PAPER_EXECUTION_ENABLED=false
PAPER_COHORT_ENABLED=false
ALPACA_PAPER_CRYPTO_ENABLED=false
CRYPTO_PENDING_ORDER_ALERT_ENABLED=false
TOSS_API_ENABLED=false
TOSS_LIVE_ORDER_MUTATIONS_ENABLED=false
KIWOOM_LIVE_MARKETDATA_ENABLED=false
NHPLUG_MOCK_ENABLED=false

# Event-driven market analysis is opt-in and fail-closed by default.
KASSET_MARKET_EVENTS_ENABLED=false
# OpenAI-only event router: Luna -> Terra -> Sol.
KASSET_AI_MODEL_LUNA=gpt-5.6-luna
KASSET_AI_MODEL_TERRA=gpt-5.6-terra
KASSET_AI_MODEL_SOL=gpt-5.6-sol
# Compatibility provider chain for existing MCP run_skill consumers.
# KASSET_AI_API_MODEL is used only when the Terra setting is empty.
KASSET_AI_PROVIDER_MODE=hybrid
KASSET_AI_API_BASE_URL=https://api.openai.com/v1
KASSET_AI_API_KEY=
KASSET_AI_API_MODEL=
KASSET_AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KASSET_AI_OPENROUTER_API_KEY=
# OpenRouter backups are used only for OAI 429/5xx/transport failures.
KASSET_AI_OPENROUTER_MODEL_FLASH=deepseek/deepseek-v4-flash-0731@preset/kasset-cheap
KASSET_AI_OPENROUTER_MODEL_PRO=deepseek/deepseek-v4-pro-0813
KASSET_AI_OPENROUTER_MODEL=

# API and background processes.
API_WORKERS=2
TASKIQ_WORKERS=1

# Resource limits/reservations. Compose applies these without provider-specific sizes.
API_CPU_LIMIT=2.00
API_MEMORY_LIMIT=2g
API_CPU_RESERVATION=0.50
API_MEMORY_RESERVATION=512m
WORKER_CPU_LIMIT=1.00
WORKER_MEMORY_LIMIT=1g
WORKER_CPU_RESERVATION=0.25
WORKER_MEMORY_RESERVATION=256m
SCHEDULER_CPU_LIMIT=0.50
SCHEDULER_MEMORY_LIMIT=512m
SCHEDULER_CPU_RESERVATION=0.10
SCHEDULER_MEMORY_RESERVATION=128m
MIGRATION_CPU_LIMIT=1.00
MIGRATION_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.50
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_RESERVATION=0.25
POSTGRES_MEMORY_RESERVATION=512m
REDIS_CPU_LIMIT=0.75
REDIS_MEMORY_LIMIT=768m
REDIS_CPU_RESERVATION=0.10
REDIS_MEMORY_RESERVATION=128m
CADDY_CPU_LIMIT=0.50
CADDY_MEMORY_LIMIT=256m
CADDY_CPU_RESERVATION=0.10
CADDY_MEMORY_RESERVATION=64m
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
